{
    "title": "TG Forwarder Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "tg_api_id": {
            "title": "Telegram API ID",
            "type": "string",
            "description": "Числовой api_id с my.telegram.org",
            "editor": "textfield"
        },
        "tg_api_hash": {
            "title": "Telegram API Hash",
            "type": "string",
            "description": "api_hash с my.telegram.org",
            "editor": "textfield",
            "isSecret": true
        },
        "tg_session": {
            "title": "Telegram Session String",
            "type": "string",
            "description": "Строка сессии Telethon StringSession",
            "editor": "textarea",
            "isSecret": true
        },
        "mail_sender": {
            "title": "Sender Gmail",
            "type": "string",
            "description": "Адрес отправителя Gmail",
            "editor": "textfield"
        },
        "mail_pass": {
            "title": "Gmail App Password",
            "type": "string",
            "description": "16-символьный пароль приложения Google",
            "editor": "textfield",
            "isSecret": true
        },
        "mail_receiver": {
            "title": "Receiver Email",
            "type": "string",
            "description": "Адрес получателя писем",
            "editor": "textfield"
        },
        "vpn_gist_url": {
            "title": "VPN Channels Gist Raw URL",
            "type": "string",
            "description": "Прямая Raw-ссылка на Gist со списком VPN-каналов (опционально)",
            "editor": "textfield"
        }
    },
    "required": [
        "tg_api_id",
        "tg_api_hash",
        "tg_session",
        "mail_sender",
        "mail_pass",
        "mail_receiver"
    ]
}
